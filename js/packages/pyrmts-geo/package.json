{
  "name": "pyrmts-geo",
  "version": "0.0.0",
  "description": "Spatial extension for pyrmts — H3/geohash/S2 indexing on top of the time pyramid.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/use-pyramid-geo.d.ts",
      "import": "./dist/use-pyramid-geo.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "license": "MIT",
  "author": "Ryan Williams <ryan@runsascoded.com>",
  "dependencies": {
    "h3-js": "^4.4.0",
    "pyrmts": "workspace:*",
    "s2js": "^1.44.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runsascoded/pyrmts.git",
    "directory": "js/packages/pyrmts-geo"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "hyparquet-writer": "^0.15.2",
    "react": "^19.2.6"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
