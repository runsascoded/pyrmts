{
  "name": "pyrmts-react",
  "version": "0.0.0",
  "description": "Shared health-page React components for pyrmts: cover timeline, shard tooltips/click-through, omnibar shard search.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kbd": {
      "types": "./dist/kbd.d.ts",
      "import": "./dist/kbd.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "license": "MIT",
  "author": "Ryan Williams <ryan@runsascoded.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runsascoded/pyrmts.git",
    "directory": "js/packages/pyrmts-react"
  },
  "dependencies": {
    "pyrmts": "workspace:*"
  },
  "peerDependencies": {
    "@floating-ui/react": ">=0.27",
    "react": ">=18",
    "use-kbd": ">=0.12"
  },
  "peerDependenciesMeta": {
    "use-kbd": {
      "optional": true
    }
  },
  "devDependencies": {
    "@floating-ui/react": "^0.27.13",
    "@types/react": "^19.2.15",
    "react": "^19.2.6",
    "use-kbd": "^0.12.0"
  },
  "sideEffects": [
    "*.css"
  ]
}
